# Get these from https://developer.spotify.com/dashboard
# Redirect URI must be registered EXACTLY (scheme, host, port, path) in the app settings.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional — only needed to let logged-out visitors search/browse.
# Server-only: deliberately has NO VITE_ prefix so Vite never inlines it into
# the client bundle. Used exclusively by api/token.ts (and its local-dev
# mirror in vite.config.ts) to run the Client Credentials flow server-side.
# Never expose this value in frontend code.
SPOTIFY_CLIENT_SECRET=your_client_secret_here
